# UK environment template. Copy to .env.uk and fill in real values, then run any script with
# ENV_FILE=.env.uk set (see src/config/env.ts) to target this environment instead of the default
# US one in .env.example/.env. .env.uk is gitignored and must never be committed.
#
# PowerShell: $env:ENV_FILE='.env.uk'; npm run test:chrome
# bash:       ENV_FILE=.env.uk npm run test:chrome
#
# CMS_BASE_URL/CMS_USERNAME/CMS_PASSWORD are CONFIRMED LIVE 2026-09-16 — real login against
# https://uk.test.givergy.com/cms-next/ succeeded using the existing Page Object Model unmodified
# (the earlier /manage/#events URL floated for this environment was the OLD legacy CMS, not
# cms-next — a different product; don't use it). Everything below CMS_PASSWORD is still an
# unverified placeholder (domain-swapped from the US values) — confirm each one against the real
# UK environment before relying on a run beyond login.

ENV_NAME=uk-integration

# CMS (cms-next) under test. Must end with a trailing slash — Playwright resolves
# leading-slash relative paths (e.g. page.goto('/login/')) against the origin root,
# not this path, so page objects use relative paths without a leading slash instead.
CMS_BASE_URL=https://uk.test.givergy.com/cms-next/
CMS_USERNAME=
CMS_PASSWORD=

# A pre-existing test campaign/event in the UK environment, reused across runs. CONFIRMED LIVE
# 2026-09-16 — "QAEVENTAPPUK2026" (account qaclientssuuk), found by searching the UK events list
# for a long-lived (05/01/2026-31/12/2026) dedicated QA campaign rather than one of the dozens of
# one-day scratch test events around it. The checklist suite's Page Object Model works against it
# completely unmodified. One confirmed real (not a bug) gap: this event's checklist has no
# "Set up the ability for DAF Pay" item — DAF (Donor-Advised Fund) is a US charitable-giving/tax
# concept that doesn't apply to UK charities, so checklist.spec.ts's "every item" and "completion
# percentage" tests aren't expected to pass as-is against it; the section-heading test does.
TEST_EVENT_ID=be4b0753-ea1b-11f0-982c-5a8758fb4524

# Lite UI (public-facing) test campaign — the live website slug for TEST_EVENT_ID above.
LITE_UI_BASE_URL=
LITE_UI_SKIP_HOLDING=

# ---------------------------------------------------------------------------
# Fundraising / outcome suite (tests/e2e, tests/api) — DELIBERATELY OUT OF SCOPE for UK, not just
# unfilled. Checked live 2026-09-16: this UK event's Payment Settings show Currency: GBP,
# Country Code: GB, fees in £. Every donor-journey page object and src/utils/money.ts itself is
# hardcoded to USD formatting and literal "$" locators, shared code every US test also depends on
# — porting this suite to UK means making money formatting currency-aware first, not just creating
# GBP fixtures. See README's "Targeting a different environment" section before attempting this.
E2E_EVENT_ID=
E2E_LITE_UI_BASE_URL=
E2E_API_GUEST_ID=
E2E_TICKET_ID=
E2E_LOT_ID=
E2E_BUYNOW_LOT_ID=
E2E_SEALED_LOT_ID=
E2E_RAFFLE_ID=

# Back-end APIs (same host as the UIs). No trailing slash. UNVERIFIED — assumed from the same
# path pattern as the US environment (EMS_API_BASE_URL/LITE_API_BASE_URL there are /ems, /lite
# off the same host as CMS_BASE_URL/LITE_UI_BASE_URL); confirm against the real UK host.
EMS_API_BASE_URL=https://uk.test.givergy.com/ems
LITE_API_BASE_URL=https://uk.test.givergy.com/lite
