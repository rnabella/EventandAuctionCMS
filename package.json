{
  "name": "givergy-qa-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise QA automation platform for Givergy CMS and Lite UI",
  "scripts": {
    "test": "playwright test --project=setup --project=cms-auth --project=cms-chromium",
    "test:headed": "playwright test --headed --project=setup --project=cms-auth --project=cms-chromium",
    "test:ui": "playwright test --ui",
    "cleanup": "playwright test --project=maintenance",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "test:api": "playwright test --project=api-setup --project=api",
    "test:e2e": "playwright test --project=api-setup --project=lite-e2e --workers=1",
    "test:e2e:headed": "playwright test --project=api-setup --project=lite-e2e --workers=1 --headed",
    "test:fundraising": "npm run test:api && npm run test:e2e",
    "test:all": "npm test && npm run test:fundraising",
    "test:regression": "npm run test:all",
    "test:smoke": "playwright test --project=setup --project=cms-auth --project=cms-chromium --project=api-setup --project=api --grep @smoke",
    "test:smoke:headed": "playwright test --project=setup --project=cms-auth --project=cms-chromium --project=api-setup --project=api --grep @smoke --headed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0"
  }
}
