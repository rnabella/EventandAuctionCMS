# Copy this file to .env and fill in real values. .env is gitignored and must never be committed.

# Which environment this run targets (used only for logging/reporting labels)
ENV_NAME=integration

# CMS (cms-next) under test. Must end with a trailing slash — Playwright resolves
# leading-slash relative paths (e.g. page.goto('/login/')) against the origin root,
# not this path, so page objects use relative paths without a leading slash instead.
CMS_BASE_URL=https://us.test.givergy.com/cms-next/
CMS_USERNAME=
CMS_PASSWORD=

# A pre-existing test campaign/event in the target environment, reused across runs
TEST_EVENT_ID=

# Lite UI (public-facing) test campaign
LITE_UI_BASE_URL=
LITE_UI_SKIP_HOLDING=

# ---------------------------------------------------------------------------
# Fundraising / outcome suite (tests/e2e, tests/api). Uses a DEDICATED, clean
# event that the checklist suite never writes to — see docs/superpowers/specs.
E2E_EVENT_ID=5a5bef87-a9e7-11f1-90d8-92b18db85c99
E2E_LITE_UI_BASE_URL=https://us.test.givergy.com/robteste2eauto1
# A registered, card-verified guest on the E2E event, used by the pure-API
# donation tests (they create and then cancel donations for this guest).
E2E_API_GUEST_ID=45233131-a9f2-11f1-abdd-8eb06de9a9e7
# The pre-created "QA E2E Ticket" ($20) on the E2E event; api-setup keeps it sellable (stock, sale end).
E2E_TICKET_ID=20bb7708-aa09-11f1-90d8-92b18db85c99
# The pre-created "QA E2E Silent Lot" (bidMode "hybrid", minStartPrice $25) / "QA E2E Buy Now Lot" ($50) /
# "QA E2E Sealed Lot" (bidMode "sealed", minStartPrice $25) on the E2E event; api-setup keeps them sellable.
E2E_LOT_ID=d9ac19b6-aa56-11f1-808b-92b18db85c99
E2E_BUYNOW_LOT_ID=dcda4f73-aa56-11f1-808b-92b18db85c99
E2E_SEALED_LOT_ID=e055e1e0-aa56-11f1-808b-92b18db85c99
# The pre-created "QA E2E Raffle" ($10/entry, "3 for $25" bundle) on the E2E event; api-setup keeps it sellable.
E2E_RAFFLE_ID=dfccd31e-aba2-11f1-926d-666441e9836d

# Back-end APIs (same host as the UIs). No trailing slash.
EMS_API_BASE_URL=https://us.test.givergy.com/ems
LITE_API_BASE_URL=https://us.test.givergy.com/lite
